      "type": "text",
      "x": 74,
      "y": 822,
      "width": 891.0000000000001,
      "height": 18.75,
      "fontSize": 15,
      "fontFamily": 1,
      "text": "Containers in a pod reach each other on localhost, are always scheduled together, and live and die together.",
      "originalText": "Containers in a pod reach each other on localhost, are always scheduled together, and live and die together.",
