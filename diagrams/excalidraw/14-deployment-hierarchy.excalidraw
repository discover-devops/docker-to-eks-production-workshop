      "x": 700,
      "y": 426,
      "width": 361.90000000000003,
      "height": 17.5,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Every replacement gets a NEW NAME and a NEW IP.",
      "originalText": "Every replacement gets a NEW NAME and a NEW IP.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "id": "el000016",
