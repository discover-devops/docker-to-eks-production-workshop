      "type": "text",
      "x": 104,
      "y": 596,
      "width": 775.5000000000001,
      "height": 18.75,
      "fontSize": 15,
      "fontFamily": 1,
      "text": "There are no pointers, no IDs, no foreign keys. A ReplicaSet does not hold a list of its pods.",
      "originalText": "There are no pointers, no IDs, no foreign keys. A ReplicaSet does not hold a list of its pods.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "el00001b",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 752305,
      "version": 1,
      "versionNonce": 760224,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 104,
      "y": 622,
      "width": 882.7500000000001,
      "height": 18.75,
      "fontSize": 15,
      "fontFamily": 1,
      "text": "It holds a QUERY:  \"every pod labelled app=catalog-api\".  It counts the matches and acts on the difference.",
      "originalText": "It holds a QUERY:  \"every pod labelled app=catalog-api\".  It counts the matches and acts on the difference.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 15
    },
