      "x": 74,
      "y": 794,
      "width": 874.5000000000001,
      "height": 18.75,
      "fontSize": 15,
      "fontFamily": 1,
      "text": "A pod holds one or more containers that share an IP address, a network namespace and storage. Usually one.",
      "originalText": "A pod holds one or more containers that share an IP address, a network namespace and storage. Usually one.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 15
    },
    {
      "id": "el000022",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
