      "width": 361.90000000000003,
      "height": 17.5,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Pods are created and destroyed, never repaired.",
      "originalText": "Pods are created and destroyed, never repaired.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "id": "el000015",
