      "x": 700,
      "y": 458,
      "width": 354.20000000000005,
      "height": 17.5,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Which is why nothing should ever address a pod",
      "originalText": "Which is why nothing should ever address a pod",
