      "width": 514.8000000000001,
      "height": 22.5,
      "fontSize": 18,
      "fontFamily": 1,
      "text": "Labels and selectors are the only glue in Kubernetes",
      "originalText": "Labels and selectors are the only glue in Kubernetes",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 18
    },
    {
      "id": "el00001a",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
